.create-or-alter function 
with (docstring = 'Return details about the specified ID.', folder = 'OpenData/Internal')
_resource_type_4(id: string) {
    dynamic({
        "microsoft.offazure/hypervsites": { "SingularDisplayName": "Microsoft.OffAzure hyperv site" }
