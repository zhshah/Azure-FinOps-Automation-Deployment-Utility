// resource_type
.create-or-alter function 
with (docstring = 'Return details about the specified ID.', folder = 'OpenData')
resource_type(id: string) {
    coalesce(_resource_type_1(id), _resource_type_2(id), _resource_type_3(id), _resource_type_4(id), _resource_type_5(id))
